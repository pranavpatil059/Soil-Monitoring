{
  "name": "advanced-soil-monitoring-system",
  "version": "2.0.0",
  "description": "Advanced IoT-based Soil Monitoring System - IIT Bombay Smart Agriculture",
  "main": "advanced-backend.js",
  "scripts": {
    "start": "node advanced-backend.js",
    "dev": "nodemon advanced-backend.js",
    "simple": "node soil-monitoring-app.js",

    "setup": "node setup-credentials.js",
    "security-check": "node security-check.js",
    "clean-cache": "rm -rf cached-photos/*",
    "backup-env": "cp .env .env.backup.$(date +%s) 2>/dev/null || echo 'No .env file to backup'",
    "validate-env": "node -e \"require('dotenv').config(); console.log('✅ Environment variables loaded successfully');\"",

    "build": "echo 'Build completed'",
    "vercel-build": "echo 'Vercel build completed'"
  },
  "keywords": [
    "soil",
    "monitoring",
    "agriculture",
    "iot",
    "sensors",
    "ai",
    "iit-bombay"
  ],
  "author": "IIT Bombay Smart Agriculture Team",
  "license": "MIT",
  "dependencies": {
    "@serialport/bindings-cpp": "^13.0.1",
    "@serialport/parser-readline": "^13.0.0",
    "@serialport/stream": "^13.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "dropbox": "^10.34.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "node-fetch": "^2.7.0",
    "serialport": "^13.0.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}
